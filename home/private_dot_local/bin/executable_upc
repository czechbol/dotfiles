#!/bin/bash

set -euo pipefail


if ! command -v gum &> /dev/null; then
  echo "Error: 'gum' is required but not installed."
  echo ""
  echo "Install it with:"
  echo "  macOS:   brew install gum"
  echo "  Linux:   See https://github.com/charmbracelet/gum#installation"
  echo "  Golang:  go install github.com/charmbracelet/gum@latest"
  echo ""
  exit 1
fi

readonly DEFAULT_NAMESPACE="uptrace"
readonly DEFAULT_SERVICE="uptrace"
readonly DEFAULT_SECRET="uptrace"
readonly PORT_RANGE_START=15000
readonly PORT_RANGE_END=25000
readonly PORT_FIND_ATTEMPTS=10
readonly PORT_FORWARD_TIMEOUT=30
readonly PORT_FORWARD_RECONNECT_TIMEOUT=10
readonly PORT_FORWARD_MAX_RETRIES=999

QUIET=false
SHOW_PASSWORD=true
OPEN_BROWSER=true

context=""
namespace="$DEFAULT_NAMESPACE"
service="$DEFAULT_SERVICE"
secret="$DEFAULT_SECRET"
port=""
pf_pid=""
pf_monitor_pid=""
pf_retry_count=0

show_header() {
  gum style \
    --border double \
    --padding "1 2" \
    --border-foreground 45 \
    --bold \
    "Uptrace Connection Tool" \
    "" \
    "Context:   ${context:-<none>}" \
    "Namespace: ${namespace}"
}

error() {
  gum style --foreground 196 --bold "✗ Error: $*"
  exit 1
}

warning() {
  gum style --foreground 214 --bold "⚠ WARNING: $*"
}

success() {
  gum style --foreground 2 --bold "✓ $*"
}

info() {
  if [[ "$QUIET" == "false" ]]; then
    gum style --foreground 33 "$*"
  fi
}

usage() {
  gum style --border rounded --padding "1 2" --border-foreground 33 \
    "Usage: $(basename "$0") [OPTIONS]" \
    "" \
    "OPTIONS:" \
    "  -x, --context CONTEXT    Kubernetes context" \
    "  -n, --namespace NS       Namespace (default: $DEFAULT_NAMESPACE)" \
    "  -s, --service SERVICE    Service name (default: $DEFAULT_SERVICE)" \
    "  --secret SECRET          Secret name (default: $DEFAULT_SECRET)" \
    "  -p, --port PORT          Local port (default: auto-assign)" \
    "  --no-password            Don't display password" \
    "  --no-browser             Don't open browser" \
    "  -q, --quiet              Quiet mode" \
    "  -h, --help               Show this help"
  exit 0
}

while [[ $# -gt 0 ]]; do
  case $1 in
    -x|--context) context="$2"; shift 2 ;;
    -n|--namespace) namespace="$2"; shift 2 ;;
    -s|--service) service="$2"; shift 2 ;;
    --secret) secret="$2"; shift 2 ;;
    -p|--port) port="$2"; shift 2 ;;
    --no-password) SHOW_PASSWORD=false; shift ;;
    --no-browser) OPEN_BROWSER=false; shift ;;
    -q|--quiet) QUIET=true; shift ;;
    -h|--help) usage ;;
    *) error "Unknown option: $1" ;;
  esac
done

for tool in kubectl nc; do
  if ! command -v "$tool" &> /dev/null; then
    error "Required tool '$tool' not found"
  fi
done

handle_kubectl_error() {
  local error_output="$1"
  local current_context=$(kubectl config current-context 2>/dev/null || echo "unknown")

  if echo "$error_output" | grep -qiE "(timed out|i/o timeout|context deadline exceeded)"; then
    error "Connection timeout - cluster unreachable.

Possible causes:
  • VPN not connected
  • Cluster network unreachable
  • Firewall blocking connection

Current context: $current_context"
  elif echo "$error_output" | grep -qiE "(unable to connect|connection refused|could not resolve|no such host)"; then
    error "Unable to connect to cluster.

Possible causes:
  • VPN not connected
  • Cluster endpoint unreachable
  • DNS resolution failure

Current context: $current_context"
  elif echo "$error_output" | grep -qiE "(token.*expired|not logged in|unauthorized|authentication|gke-gcloud-auth-plugin|failed to retrieve access token|no active account|gcloud.*config.*helper)"; then
    if [[ "$current_context" == gke_* ]] || echo "$error_output" | grep -qiE "(gcloud|gke-gcloud-auth-plugin)"; then
      error "GKE authentication expired.

Please re-authenticate:
  gcloud auth login
  gcloud auth application-default login

Or refresh cluster credentials:
  gcloud container clusters get-credentials <cluster-name> --region <region>

Current context: $current_context"
    else
      error "Kubernetes authentication failed.

Please check your cluster credentials and re-authenticate.

Current context: $current_context"
    fi
  else
    error "Kubectl command failed: $error_output"
  fi
}

get_current_context() {
  kubectl config current-context 2>/dev/null || echo ""
}

list_contexts() {
  kubectl config get-contexts -o name 2>/dev/null || echo ""
}

if [[ -z "$context" ]]; then
  current_ctx=$(get_current_context)
  if [[ -z "$current_ctx" ]]; then
    error "No kubernetes context available"
  fi

  mapfile -t contexts < <(list_contexts)
  if [[ ${#contexts[@]} -eq 0 ]]; then
    error "No contexts available"
  fi

  mapfile -t sorted_contexts < <(printf '%s\n' "${contexts[@]}" | grep -v "^${current_ctx}$" | sort)
  ordered_contexts=("$current_ctx" "${sorted_contexts[@]}")

  info "Select Kubernetes context:"
  context=$(printf '%s\n' "${ordered_contexts[@]}" | \
    gum filter --placeholder "Type to search..." --header "Current: $current_ctx" --height 15)
fi

find_available_port() {
  local port
  for ((i=1; i<=PORT_FIND_ATTEMPTS; i++)); do
    port=$((PORT_RANGE_START + RANDOM % (PORT_RANGE_END - PORT_RANGE_START)))
    if ! nc -z localhost "$port" 2>/dev/null; then
      echo "$port"
      return 0
    fi
  done
  echo "14318"
}

if [[ -z "$port" ]]; then
  port=$(find_available_port)
fi

[[ "$QUIET" == "false" ]] && show_header

ctx_flag=""
[[ -n "$context" ]] && ctx_flag="--context=$context"

get_password() {
  local output
  output=$(timeout 10 kubectl $ctx_flag -n "$namespace" get secret "$secret" -o go-template='{{index .data "uptrace-admin-password" | base64decode}}' 2>&1)
  local exit_code=$?

  if [[ $exit_code -eq 124 ]]; then
    echo "KUBECTL_ERROR: kubectl command timed out after 10s" >&2
    return 1
  fi

  if [[ $exit_code -ne 0 ]]; then
    echo "KUBECTL_ERROR: $output" >&2
    return 1
  fi

  echo "$output"
}

password=$(gum spin --spinner dot --title "Retrieving credentials..." -- bash -c "
  $(declare -f get_password)
  ctx_flag='$ctx_flag'
  namespace='$namespace'
  secret='$secret'
  get_password 2>&1
  exit \$?
")
password_exit=$?

if [[ $password_exit -ne 0 ]]; then
  if echo "$password" | grep -q "KUBECTL_ERROR:"; then
    error_msg=$(echo "$password" | grep "KUBECTL_ERROR:" | head -1 | sed 's/KUBECTL_ERROR: //')
    handle_kubectl_error "$error_msg"
  else
    error "Failed to retrieve password from secret '$secret'"
  fi
elif [[ -z "$password" ]]; then
  error "Failed to retrieve password from secret '$secret'"
fi

success "Credentials retrieved"

clipboard_tool=""
if command -v wl-copy &>/dev/null; then
  clipboard_tool="wl-copy"
elif command -v xclip &>/dev/null; then
  clipboard_tool="xclip -selection clipboard"
elif command -v xsel &>/dev/null; then
  clipboard_tool="xsel --clipboard"
elif command -v pbcopy &>/dev/null; then
  clipboard_tool="pbcopy"
fi

if [[ -n "$clipboard_tool" ]]; then
  echo -n "$password" | $clipboard_tool 2>/dev/null
  clipboard_status="✓ Password copied to clipboard"
else
  clipboard_status="(clipboard tool not found)"
fi

echo ""
gum style --border rounded --padding "1 2" --border-foreground 45 --bold \
  "Uptrace Connection Information" \
  "" \
  "URL:      http://localhost:$port/" \
  "Username: uptrace  OR  uptrace@whalebone.io" \
  "          (depends on your Uptrace version)" \
  "Password: $(if [[ "$SHOW_PASSWORD" == "true" ]]; then echo "$password"; else echo "<hidden>"; fi)" \
  "" \
  "$clipboard_status"
echo ""

verify_service() {
  local output
  output=$(timeout 10 kubectl $ctx_flag -n "$namespace" get service "$service" 2>&1)
  local exit_code=$?

  if [[ $exit_code -eq 124 ]]; then
    echo "KUBECTL_ERROR: kubectl command timed out after 10s" >&2
    return 1
  fi

  if [[ $exit_code -ne 0 ]]; then
    echo "KUBECTL_ERROR: $output" >&2
    return 1
  fi
}

verify_output=$(gum spin --spinner dot --title "Verifying service..." -- bash -c "
  $(declare -f verify_service)
  ctx_flag='$ctx_flag'
  namespace='$namespace'
  service='$service'
  verify_service 2>&1
  exit \$?
")
verify_exit=$?

if [[ $verify_exit -ne 0 ]]; then
  if echo "$verify_output" | grep -q "KUBECTL_ERROR:"; then
    error_msg=$(echo "$verify_output" | grep "KUBECTL_ERROR:" | head -1 | sed 's/KUBECTL_ERROR: //')
    handle_kubectl_error "$error_msg"
  else
    error "Service '$service' not found in namespace '$namespace'"
  fi
fi

cleanup() {
  if [[ -n "$pf_pid" && -e /proc/$pf_pid ]]; then
    kill "$pf_pid" 2>/dev/null || true
  fi
  if [[ -n "$pf_monitor_pid" && -e /proc/$pf_monitor_pid ]]; then
    kill "$pf_monitor_pid" 2>/dev/null || true
  fi
}
trap cleanup EXIT INT TERM

start_port_forward() {
  local timeout="${1:-$PORT_FORWARD_TIMEOUT}"
  local attempt=0

  while [[ $attempt -lt $timeout ]]; do
    if [[ -n "$pf_pid" && -e /proc/$pf_pid ]]; then
      kill "$pf_pid" 2>/dev/null || true
      wait "$pf_pid" 2>/dev/null || true
    fi

    kubectl $ctx_flag -n "$namespace" port-forward service/"$service" "$port":14318 >/dev/null 2>&1 &
    pf_pid=$!

    local ready_check=0
    while [[ $ready_check -lt 10 ]]; do
      if nc -z localhost "$port" 2>/dev/null; then
        sleep 2
        echo "$pf_pid"
        return 0
      fi
      sleep 1
      ready_check=$((ready_check + 1))
      attempt=$((attempt + 1))

      if [[ $attempt -ge $timeout ]]; then
        return 1
      fi
    done
  done

  return 1
}

monitor_port_forward() {
  while true; do
    if [[ ! -e /proc/$pf_pid ]]; then
      pf_retry_count=$((pf_retry_count + 1))

      if [[ "$QUIET" == "false" ]]; then
        printf '\n\033[1;33m⚠ Port-forward disconnected (attempt %d)\033[0m\n' "$pf_retry_count" >&2
        printf '\033[38;5;240m  Reconnecting...\033[0m\n' "$pf_retry_count" >&2
      fi

      if start_port_forward "$PORT_FORWARD_RECONNECT_TIMEOUT"; then
        if [[ "$QUIET" == "false" ]]; then
          printf '\033[1;32m✓ Reconnected successfully\033[0m\n\n' >&2
        fi
      else
        if [[ $pf_retry_count -ge $PORT_FORWARD_MAX_RETRIES ]]; then
          printf '\033[1;31m✗ Max retries reached\033[0m\n' >&2
          exit 1
        fi
      fi
    fi

    sleep 2
  done
}

pf_pid=$(gum spin --spinner dot --title "Establishing connection..." -- bash -c "
  $(declare -f start_port_forward)
  context='$context'
  namespace='$namespace'
  service='$service'
  port='$port'
  ctx_flag='$ctx_flag'
  PORT_FORWARD_TIMEOUT='$PORT_FORWARD_TIMEOUT'
  pf_pid=''
  start_port_forward
")

if [[ $? -ne 0 || -z "$pf_pid" ]]; then
  error "Port-forward failed to start"
fi

success "Port-forwarding active on port $port"

monitor_port_forward &
pf_monitor_pid=$!

if [[ "$OPEN_BROWSER" == "true" ]]; then
  browser_cmd=""
  if command -v xdg-open &>/dev/null; then
    browser_cmd="xdg-open"
  elif command -v open &>/dev/null; then
    browser_cmd="open"
  elif command -v wslview &>/dev/null; then
    browser_cmd="wslview"
  fi

  if [[ -n "$browser_cmd" ]]; then
    gum style --foreground 33 "Opening browser..."
    $browser_cmd "http://localhost:$port/" &>/dev/null &
    success "Browser opened"
  fi
fi

echo ""
gum style --foreground 240 "Port-forwarding active. Press Ctrl+C to exit."
echo ""

wait "$pf_monitor_pid" 2>/dev/null || true

echo ""
gum style --foreground 2 "✓ Disconnected. Goodbye!"
