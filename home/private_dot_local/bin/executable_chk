#!/bin/bash

set -euo pipefail


if ! command -v gum &> /dev/null; then
  echo "Error: 'gum' is required but not installed."
  echo ""
  echo "Install it with:"
  echo "  macOS:   brew install gum"
  echo "  Linux:   See https://github.com/charmbracelet/gum#installation"
  echo "  Golang:  go install github.com/charmbracelet/gum@latest"
  echo ""
  exit 1
fi

readonly CLICKHOUSE_PORT=9000
readonly PORT_RANGE_START=15000
readonly PORT_RANGE_END=25000
readonly PORT_FIND_ATTEMPTS=10
readonly PORT_FORWARD_TIMEOUT=30
readonly PORT_FORWARD_RECONNECT_TIMEOUT=10
readonly PORT_FORWARD_MAX_RETRIES=999

QUIET=false
READONLY=true
LIST_MODE=false

context=""
namespace=""
service=""
port=""
sql_execute=""
sql_file=""
pf_pid=""
pf_monitor_pid=""
pf_retry_count=0
namespace_explicit=false

show_header() {
  gum style \
    --border double \
    --padding "1 2" \
    --border-foreground 208 \
    --bold \
    "ClickHouse Connection Tool" \
    "" \
    "Context:   ${context:-<none>}" \
    "Namespace: ${namespace}"
}

error() {
  gum style --foreground 196 --bold "✗ Error: $*"
  exit 1
}

warning() {
  gum style --foreground 214 --bold "⚠ WARNING: $*"
}

success() {
  gum style --foreground 2 --bold "✓ $*"
}

info() {
  if [[ "$QUIET" == "false" ]]; then
    gum style --foreground 33 "$*"
  fi
}

usage() {
  gum style --border rounded --padding "1 2" --border-foreground 33 \
    "Usage: $(basename "$0") [OPTIONS]" \
    "" \
    "OPTIONS:" \
    "  -x, --context CONTEXT    Kubernetes context" \
    "  -n, --namespace NS       Namespace (skips cluster-wide search)" \
    "  -s, --service SERVICE    Service name to connect to" \
    "  -p, --port PORT          Local port (default: auto-assign)" \
    "  -e, --execute SQL        Execute SQL and exit" \
    "  -f, --file FILE          Execute SQL from file" \
    "  -w, --read-write         Enable write mode (default: read-only)" \
    "  -l, --list               List ClickHouse services" \
    "  -q, --quiet              Quiet mode" \
    "  -h, --help               Show this help"
  exit 0
}

while [[ $# -gt 0 ]]; do
  case $1 in
    -x|--context) context="$2"; shift 2 ;;
    -n|--namespace) namespace="$2"; namespace_explicit=true; shift 2 ;;
    -s|--service) service="$2"; shift 2 ;;
    -p|--port) port="$2"; shift 2 ;;
    -e|--execute) sql_execute="$2"; QUIET=true; shift 2 ;;
    -f|--file) sql_file="$2"; QUIET=true; shift 2 ;;
    -w|--read-write) READONLY=false; shift ;;
    -l|--list) LIST_MODE=true; shift ;;
    -q|--quiet) QUIET=true; shift ;;
    -h|--help) usage ;;
    *) error "Unknown option: $1" ;;
  esac
done

for tool in kubectl nc clickhouse-client jq; do
  if ! command -v "$tool" &> /dev/null; then
    error "Required tool '$tool' not found"
  fi
done

handle_kubectl_error() {
  local error_output="$1"
  local current_context=$(kubectl config current-context 2>/dev/null || echo "unknown")

  if echo "$error_output" | grep -qiE "(timed out|i/o timeout|context deadline exceeded)"; then
    error "Connection timeout - cluster unreachable.

Possible causes:
  • VPN not connected
  • Cluster network unreachable
  • Firewall blocking connection

Current context: $current_context"
  elif echo "$error_output" | grep -qiE "(unable to connect|connection refused|could not resolve|no such host)"; then
    error "Unable to connect to cluster.

Possible causes:
  • VPN not connected
  • Cluster endpoint unreachable
  • DNS resolution failure

Current context: $current_context"
  elif echo "$error_output" | grep -qiE "(token.*expired|not logged in|unauthorized|authentication|gke-gcloud-auth-plugin|failed to retrieve access token|no active account|gcloud.*config.*helper)"; then
    if [[ "$current_context" == gke_* ]] || echo "$error_output" | grep -qiE "(gcloud|gke-gcloud-auth-plugin)"; then
      error "GKE authentication expired.

Please re-authenticate:
  gcloud auth login
  gcloud auth application-default login

Or refresh cluster credentials:
  gcloud container clusters get-credentials <cluster-name> --region <region>

Current context: $current_context"
    else
      error "Kubernetes authentication failed.

Please check your cluster credentials and re-authenticate.

Current context: $current_context"
    fi
  else
    error "Kubectl command failed: $error_output"
  fi
}

get_current_context() {
  kubectl config current-context 2>/dev/null || echo ""
}

list_contexts() {
  kubectl config get-contexts -o name 2>/dev/null || echo ""
}

if [[ -z "$context" ]]; then
  current_ctx=$(get_current_context)
  if [[ -z "$current_ctx" ]]; then
    error "No kubernetes context available"
  fi

  mapfile -t contexts < <(list_contexts)
  if [[ ${#contexts[@]} -eq 0 ]]; then
    error "No contexts available"
  fi

  mapfile -t sorted_contexts < <(printf '%s\n' "${contexts[@]}" | grep -v "^${current_ctx}$" | sort)
  ordered_contexts=("$current_ctx" "${sorted_contexts[@]}")

  info "Select Kubernetes context:"
  context=$(printf '%s\n' "${ordered_contexts[@]}" | \
    gum filter --placeholder "Type to search..." --header "Current: $current_ctx" --height 15)
fi

get_current_namespace() {
  local ctx_flag=""
  [[ -n "$context" ]] && ctx_flag="--context=$context"
  kubectl config view --minify $ctx_flag -o jsonpath='{.contexts[0].context.namespace}' 2>/dev/null || echo ""
}

if [[ -z "$namespace" ]]; then
  namespace=$(get_current_namespace)
fi

[[ "$QUIET" == "false" && "$LIST_MODE" == "false" ]] && show_header

list_clickhouse_services() {
  local ctx_flag=""
  [[ -n "$context" ]] && ctx_flag="--context=$context"

  local search_flag=""
  if [[ "$namespace_explicit" == "true" ]]; then
    search_flag="-n $namespace"
  else
    search_flag="--all-namespaces"
  fi

  local output
  # Wrap kubectl with timeout to prevent hanging
  output=$(timeout 10 kubectl $ctx_flag get services $search_flag -o json 2>&1)
  local exit_code=$?

  if [[ $exit_code -eq 124 ]]; then
    output="Error: kubectl command timed out after 10s"
    exit_code=1
  fi

  if [[ $exit_code -ne 0 ]]; then
    echo "KUBECTL_ERROR: $output" >&2
    return 1
  fi

  if ! echo "$output" | jq -e . >/dev/null 2>&1; then
    echo "KUBECTL_ERROR: Invalid JSON response from kubectl" >&2
    return 1
  fi

  echo "$output" | \
    jq -r '.items[] |
    select(.spec.ports[]? | select(.port == 9000 or .targetPort == 9000)) |
    "\(.metadata.name):::\(.metadata.namespace):::\(.metadata.labels["clickhouse.altinity.com/chi"] // "")"'
}

discover_clickhouse_services() {
  local all_services=()
  local operator_services=()
  local legacy_services=()
  local seen=()
  local list_output
  local list_exit

  list_output=$(list_clickhouse_services 2>&1)
  list_exit=$?

  if [[ $list_exit -ne 0 ]]; then
    echo "$list_output" >&2
    return 1
  fi

  while IFS= read -r line; do
    [[ -z "$line" ]] && continue

    local svc_name="${line%%:::*}"
    local rest="${line#*:::}"
    local ns_name="${rest%%:::*}"
    local chi_label="${rest#*:::}"

    if [[ "$svc_name" =~ (ingress|nginx|lb-ext|load-balancer|proxy|haproxy|vector) ]]; then
      continue
    fi

    if [[ "$svc_name" =~ ^chi-.*-(cluster|rep)-[0-9] ]]; then
      continue
    fi

    if [[ "$svc_name" =~ ^chi-.*-[0-9]+-[0-9]+$ ]]; then
      continue
    fi

    local entry="${svc_name}:::${ns_name}"

    if [[ ! " ${seen[@]} " =~ " ${entry} " ]]; then
      if [[ -n "$chi_label" ]]; then
        operator_services+=("$entry")
      else
        legacy_services+=("$entry")
      fi
      seen+=("$entry")
    fi
  done <<< "$list_output"

  for op_svc in "${operator_services[@]}"; do
    all_services+=("$op_svc")
  done

  for leg_svc in "${legacy_services[@]}"; do
    local leg_name="${leg_svc%%:::*}"
    local leg_ns="${leg_svc##*:::}"
    local has_operator_version=false

    for op_svc in "${operator_services[@]}"; do
      local op_name="${op_svc%%:::*}"
      local op_ns="${op_svc##*:::}"

      if [[ "$op_ns" == "$leg_ns" && "$op_name" == *"$leg_name"* ]]; then
        has_operator_version=true
        break
      fi
    done

    if [[ "$has_operator_version" == "false" ]]; then
      all_services+=("$leg_svc")
    fi
  done

  printf '%s\n' "${all_services[@]}"
}

discovery_error_file=$(mktemp)
mapfile -t ch_entries < <(
  gum spin --spinner dot --title "Discovering ClickHouse services..." -- bash -c "
    context='$context'
    namespace_explicit='$namespace_explicit'
    namespace='$namespace'
    $(declare -f list_clickhouse_services discover_clickhouse_services)
    discover_clickhouse_services 2>'$discovery_error_file'
  "
)

if [[ -s "$discovery_error_file" ]]; then
  discovery_error=$(cat "$discovery_error_file")
  rm -f "$discovery_error_file"

  if echo "$discovery_error" | grep -q "KUBECTL_ERROR:"; then
    error_msg=$(echo "$discovery_error" | grep "KUBECTL_ERROR:" | head -1 | sed 's/KUBECTL_ERROR: //')
    handle_kubectl_error "$error_msg"
  fi
fi
rm -f "$discovery_error_file"

if [[ ${#ch_entries[@]} -eq 0 ]]; then
  error "No ClickHouse services found"
fi

if [[ "$LIST_MODE" == "true" ]]; then
  if [[ "$namespace_explicit" == "true" ]]; then
    gum style --bold "ClickHouse services in namespace '$namespace':"
  else
    gum style --bold "ClickHouse services across all namespaces:"
  fi
  echo ""

  for entry in "${ch_entries[@]}"; do
    if [[ "$entry" =~ ^([^:]+):::([^:]+)$ ]]; then
      name="${BASH_REMATCH[1]}"
      ns="${BASH_REMATCH[2]}"
      gum style --foreground 33 "  • ${ns}.${name}"
    fi
  done
  exit 0
fi

if [[ -z "$service" ]]; then
  mapfile -t sorted_entries < <(
    for entry in "${ch_entries[@]}"; do
      if [[ "$entry" =~ ^([^:]+):::([^:]+)$ ]]; then
        name="${BASH_REMATCH[1]}"
        ns="${BASH_REMATCH[2]}"
        echo "${ns}.${name}|||${entry}"
      fi
    done | sort | cut -d'|' -f4-
  )

  display_items=()
  for entry in "${sorted_entries[@]}"; do
    if [[ "$entry" =~ ^([^:]+):::([^:]+)$ ]]; then
      name="${BASH_REMATCH[1]}"
      ns="${BASH_REMATCH[2]}"
      display_items+=("${ns}.${name}")
    fi
  done

  if [[ ${#sorted_entries[@]} -eq 1 ]]; then
    selected_display="${display_items[0]}"
    selected_entry="${sorted_entries[0]}"
  else
    info "Select ClickHouse service:"
    selected_display=$(printf '%s\n' "${display_items[@]}" | \
      gum filter --placeholder "Type to search..." --height 20 --header "Select ClickHouse service to connect:")

    for i in "${!display_items[@]}"; do
      if [[ "${display_items[$i]}" == "$selected_display" ]]; then
        selected_entry="${sorted_entries[$i]}"
        break
      fi
    done
  fi

  if [[ "$selected_entry" =~ ^([^:]+):::([^:]+)$ ]]; then
    service="${BASH_REMATCH[1]}"
    namespace="${BASH_REMATCH[2]}"
  fi
else
  for entry in "${ch_entries[@]}"; do
    if [[ "$entry" =~ ^([^:]+):::([^:]+)$ ]]; then
      if [[ "${BASH_REMATCH[1]}" == "$service" ]]; then
        namespace="${BASH_REMATCH[2]}"
        break
      fi
    fi
  done
fi

if [[ -z "$service" || -z "$namespace" ]]; then
  error "Service selection failed"
fi

success "Selected: ${namespace}.${service}"

find_available_port() {
  local port
  for ((i=1; i<=PORT_FIND_ATTEMPTS; i++)); do
    port=$((PORT_RANGE_START + RANDOM % (PORT_RANGE_END - PORT_RANGE_START)))
    if ! nc -z localhost "$port" 2>/dev/null; then
      echo "$port"
      return 0
    fi
  done
  echo "9123"
}

if [[ -z "$port" ]]; then
  port=$(find_available_port)
fi

ctx_flag=""
[[ -n "$context" ]] && ctx_flag="--context=$context"

connection_type="read-only"
if [[ "$READONLY" == "false" ]]; then
  connection_type="read-write"
  warning "Connecting with READ-WRITE access"
  gum style --foreground 240 "  Use caution - changes will be written to the database"
  echo ""
fi

echo ""
gum style --foreground 33 "Connecting to ${namespace}/${service} [$connection_type]"
gum style --foreground 240 "  Port: $port → $CLICKHOUSE_PORT"
echo ""

cleanup() {
  if [[ -n "$pf_pid" && -e /proc/$pf_pid ]]; then
    kill "$pf_pid" 2>/dev/null || true
  fi
  if [[ -n "$pf_monitor_pid" && -e /proc/$pf_monitor_pid ]]; then
    kill "$pf_monitor_pid" 2>/dev/null || true
  fi
}
trap cleanup EXIT INT TERM

start_port_forward() {
  local timeout="${1:-$PORT_FORWARD_TIMEOUT}"
  local attempt=0

  while [[ $attempt -lt $timeout ]]; do
    if [[ -n "$pf_pid" && -e /proc/$pf_pid ]]; then
      kill "$pf_pid" 2>/dev/null || true
      wait "$pf_pid" 2>/dev/null || true
    fi

    kubectl $ctx_flag -n "$namespace" port-forward service/"$service" "$port":"$CLICKHOUSE_PORT" >/dev/null 2>&1 &
    pf_pid=$!

    local ready_check=0
    while [[ $ready_check -lt 10 ]]; do
      if nc -z localhost "$port" 2>/dev/null; then
        sleep 2
        return 0
      fi
      sleep 1
      ready_check=$((ready_check + 1))
      attempt=$((attempt + 1))

      if [[ $attempt -ge $timeout ]]; then
        return 1
      fi
    done
  done

  return 1
}

monitor_port_forward() {
  while true; do
    if [[ ! -e /proc/$pf_pid ]]; then
      pf_retry_count=$((pf_retry_count + 1))

      if [[ "$QUIET" == "false" ]]; then
        printf '\n\033[1;33m⚠ Port-forward disconnected (attempt %d)\033[0m\n' "$pf_retry_count" >&2
        printf '\033[38;5;240m  Reconnecting...\033[0m\n' "$pf_retry_count" >&2
      fi

      if start_port_forward "$PORT_FORWARD_RECONNECT_TIMEOUT"; then
        if [[ "$QUIET" == "false" ]]; then
          printf '\033[1;32m✓ Reconnected successfully\033[0m\n\n' >&2
        fi
      else
        if [[ $pf_retry_count -ge $PORT_FORWARD_MAX_RETRIES ]]; then
          printf '\033[1;31m✗ Max retries reached\033[0m\n' >&2
          exit 1
        fi
      fi
    fi

    sleep 2
  done
}

gum spin --spinner dot --title "Establishing connection..." -- bash -c "
  $(declare -f start_port_forward)
  context='$context'
  namespace='$namespace'
  service='$service'
  port='$port'
  CLICKHOUSE_PORT='$CLICKHOUSE_PORT'
  ctx_flag='$ctx_flag'
  PORT_FORWARD_TIMEOUT='$PORT_FORWARD_TIMEOUT'
  start_port_forward
  echo \$! > /tmp/chc-pf-pid.$$
"

if [[ $? -ne 0 ]]; then
  error "Port-forward failed to start"
fi

pf_pid=$(cat /tmp/chc-pf-pid.$$ 2>/dev/null)
rm -f /tmp/chc-pf-pid.$$

monitor_port_forward &
pf_monitor_pid=$!

ch_args=(clickhouse-client --host localhost --port "$port" --prompt "${context}.${service}")
if [[ "$READONLY" == "true" ]]; then
  ch_args+=(--readonly=1)
fi

if [[ -n "$sql_execute" ]]; then
  echo "$sql_execute" | "${ch_args[@]}"
elif [[ -n "$sql_file" ]]; then
  if [[ ! -f "$sql_file" ]]; then
    error "SQL file not found: $sql_file"
  fi
  "${ch_args[@]}" < "$sql_file"
else
  gum style --border rounded --padding "1" --border-foreground 33 \
    "Connected to: ${namespace}/${service}" \
    "Mode: $connection_type" \
    "Type 'exit' or press Ctrl+D to disconnect"
  echo ""

  "${ch_args[@]}"
fi

echo ""
gum style --foreground 2 "✓ Disconnected. Goodbye!"
