#!/bin/bash

set -euo pipefail


if ! command -v gum &> /dev/null; then
  echo "Error: 'gum' is required but not installed."
  echo ""
  echo "Install it with:"
  echo "  macOS:   brew install gum"
  echo "  Linux:   See https://github.com/charmbracelet/gum#installation"
  echo "  Golang:  go install github.com/charmbracelet/gum@latest"
  echo ""
  exit 1
fi

readonly PORT_RANGE_START=15000
readonly PORT_RANGE_END=25000
readonly PORT_FIND_ATTEMPTS=10
readonly PORT_FORWARD_TIMEOUT=60
readonly PORT_FORWARD_RECONNECT_TIMEOUT=15
readonly PGPASS_FILE_MODE=600
readonly PG_CONNECT_TIMEOUT=10
readonly PORT_FORWARD_MAX_RETRIES=999

QUIET=false
LIST_MODE=false
READ_WRITE=false
USE_POOLER=false

context=""
namespace=""
cluster=""
port=""
database=""
sql_execute=""
sql_file=""
pgpass_file=""
pf_pid=""
pf_monitor_pid=""
pf_retry_count=0
namespace_explicit=false
db_type=""

show_header() {
  gum style \
    --border double \
    --padding "1 2" \
    --border-foreground 212 \
    --bold \
    "PostgreSQL Connection Tool" \
    "" \
    "Context:   ${context:-<none>}" \
    "Namespace: ${namespace:-<none>}"
}

error() {
  gum style --foreground 196 --bold "✗ Error: $*"
  exit 1
}

warning() {
  gum style --foreground 214 --bold "⚠ WARNING: $*"
}

success() {
  gum style --foreground 2 --bold "✓ $*"
}

info() {
  if [[ "$QUIET" == "false" ]]; then
    gum style --foreground 33 "$*"
  fi
}

usage() {
  gum style --border rounded --padding "1 2" --border-foreground 33 \
    "Usage: $(basename "$0") [OPTIONS]" \
    "" \
    "OPTIONS:" \
    "  -x, --context CONTEXT    Kubernetes context" \
    "  -n, --namespace NS       Namespace (skips cluster-wide search)" \
    "  -c, --cluster CLUSTER    Specify cluster name" \
    "  -p, --port PORT          Local port for forwarding" \
    "  -d, --database DB        Database name override" \
    "  -e, --execute SQL        Execute SQL and exit" \
    "  -f, --file FILE          Execute SQL from file" \
    "  -w, --read-write         Use read-write endpoint" \
    "  --pooler                 Use connection pooler" \
    "  -l, --list               List databases" \
    "  -q, --quiet              Quiet mode" \
    "  -h, --help               Show this help"
  exit 0
}

while [[ $# -gt 0 ]]; do
  case $1 in
    -x|--context) context="$2"; shift 2 ;;
    -n|--namespace) namespace="$2"; namespace_explicit=true; shift 2 ;;
    -c|--cluster) cluster="$2"; shift 2 ;;
    -p|--port) port="$2"; shift 2 ;;
    -d|--database) database="$2"; shift 2 ;;
    -e|--execute) sql_execute="$2"; QUIET=true; shift 2 ;;
    -f|--file) sql_file="$2"; QUIET=true; shift 2 ;;
    -w|--read-write) READ_WRITE=true; shift ;;
    --pooler) USE_POOLER=true; shift ;;
    -l|--list) LIST_MODE=true; shift ;;
    -q|--quiet) QUIET=true; shift ;;
    -h|--help) usage ;;
    *) error "Unknown option: $1" ;;
  esac
done

for tool in kubectl nc psql; do
  if ! command -v "$tool" &> /dev/null; then
    error "Required tool '$tool' not found"
  fi
done

handle_kubectl_error() {
  local error_output="$1"
  local current_context=$(kubectl config current-context 2>/dev/null || echo "unknown")

  if echo "$error_output" | grep -qiE "(timed out|i/o timeout|context deadline exceeded)"; then
    error "Connection timeout - cluster unreachable.

Possible causes:
  • VPN not connected
  • Cluster network unreachable
  • Firewall blocking connection

Current context: $current_context"
  elif echo "$error_output" | grep -qiE "(unable to connect|connection refused|could not resolve|no such host)"; then
    error "Unable to connect to cluster.

Possible causes:
  • VPN not connected
  • Cluster endpoint unreachable
  • DNS resolution failure

Current context: $current_context"
  elif echo "$error_output" | grep -qiE "(token.*expired|not logged in|unauthorized|authentication|gke-gcloud-auth-plugin|failed to retrieve access token|no active account|gcloud.*config.*helper)"; then
    if [[ "$current_context" == gke_* ]] || echo "$error_output" | grep -qiE "(gcloud|gke-gcloud-auth-plugin)"; then
      error "GKE authentication expired.

Please re-authenticate:
  gcloud auth login
  gcloud auth application-default login

Or refresh cluster credentials:
  gcloud container clusters get-credentials <cluster-name> --region <region>

Current context: $current_context"
    else
      error "Kubernetes authentication failed.

Please check your cluster credentials and re-authenticate.

Current context: $current_context"
    fi
  else
    error "Kubectl command failed: $error_output"
  fi
}

get_current_context() {
  kubectl config current-context 2>/dev/null || echo ""
}

list_contexts() {
  kubectl config get-contexts -o name 2>/dev/null || echo ""
}

if [[ -z "$context" ]]; then
  current_ctx=$(get_current_context)
  if [[ -z "$current_ctx" ]]; then
    error "No kubernetes context available"
  fi

  mapfile -t contexts < <(list_contexts)
  if [[ ${#contexts[@]} -eq 0 ]]; then
    error "No contexts available"
  fi

  mapfile -t sorted_contexts < <(printf '%s\n' "${contexts[@]}" | grep -v "^${current_ctx}$" | sort)
  ordered_contexts=("$current_ctx" "${sorted_contexts[@]}")

  info "Select Kubernetes context:"
  context=$(printf '%s\n' "${ordered_contexts[@]}" | \
    gum filter --placeholder "Type to search..." --header "Current: $current_ctx" --height 15)
fi

get_current_namespace() {
  local ctx_flag=""
  [[ -n "$context" ]] && ctx_flag="--context=$context"
  kubectl config view --minify $ctx_flag -o jsonpath='{.contexts[0].context.namespace}' 2>/dev/null || echo ""
}

if [[ -z "$namespace" ]]; then
  namespace=$(get_current_namespace)
fi

[[ "$QUIET" == "false" && "$LIST_MODE" == "false" ]] && show_header

list_databases() {
  local ctx_flag=""
  [[ -n "$context" ]] && ctx_flag="--context=$context"

  local search_flag=""
  if [[ "$namespace_explicit" == "true" ]]; then
    search_flag="-n $namespace"
  else
    search_flag="--all-namespaces"
  fi

  local output
  local error_output
  # Wrap kubectl with timeout to prevent hanging (don't use --request-timeout, it interferes)
  output=$(timeout 10 kubectl $ctx_flag get services $search_flag -o json 2>&1)
  local exit_code=$?

  # Check if timeout killed the command
  if [[ $exit_code -eq 124 ]]; then
    output="Error: kubectl command timed out after 10s"
    exit_code=1
  fi

  if [[ $exit_code -ne 0 ]]; then
    echo "KUBECTL_ERROR: $output" >&2
    return 1
  fi

  # Check if output is valid JSON
  if ! echo "$output" | jq -e . >/dev/null 2>&1; then
    echo "KUBECTL_ERROR: Invalid JSON response from kubectl" >&2
    return 1
  fi

  echo "$output" | jq -r '.items[] |
    select(.spec.ports[]? | select(.port == 5432 or .targetPort == 5432)) |
    "\(.metadata.name):::\(.metadata.namespace)"'
}

discover_databases() {
  local all_dbs=()
  local seen=()
  local list_output
  local list_exit

  list_output=$(list_databases 2>&1)
  list_exit=$?

  if [[ $list_exit -ne 0 ]]; then
    echo "$list_output" >&2
    return 1
  fi

  while IFS= read -r line; do
    [[ -z "$line" ]] && continue

    local svc_name="${line%%:::*}"
    local ns_name="${line##*:::}"

    if [[ "$svc_name" =~ (ingress|nginx|lb-ext|load-balancer|proxy|haproxy) ]]; then
      continue
    fi

    if [[ "$svc_name" =~ -r(o|w)?$ ]]; then
      local cluster_name=$(echo "$svc_name" | sed -E 's/-r(o|w)?$//')
      local entry="${cluster_name}:::${ns_name}:::cnpg"

      if [[ ! " ${seen[@]} " =~ " ${entry} " ]]; then
        all_dbs+=("$entry")
        seen+=("$entry")
      fi
    elif [[ "$svc_name" =~ -pooler$ ]]; then
      continue
    else
      local entry="${svc_name}:::${ns_name}:::deployment"

      if [[ ! " ${seen[@]} " =~ " ${entry} " ]]; then
        all_dbs+=("$entry")
        seen+=("$entry")
      fi
    fi
  done <<< "$list_output"

  printf '%s\n' "${all_dbs[@]}"
}

# Capture stderr to check for errors while keeping spinner working
discovery_error_file=$(mktemp)
mapfile -t db_entries < <(
  gum spin --spinner dot --title "Discovering databases..." -- bash -c "
    context='$context'
    namespace_explicit='$namespace_explicit'
    namespace='$namespace'
    $(declare -f list_databases discover_databases)
    discover_databases 2>'$discovery_error_file'
  "
)

# Check for kubectl errors in stderr
if [[ -s "$discovery_error_file" ]]; then
  discovery_error=$(cat "$discovery_error_file")
  rm -f "$discovery_error_file"

  if echo "$discovery_error" | grep -q "KUBECTL_ERROR:"; then
    error_msg=$(echo "$discovery_error" | grep "KUBECTL_ERROR:" | head -1 | sed 's/KUBECTL_ERROR: //')
    handle_kubectl_error "$error_msg"
  fi
fi
rm -f "$discovery_error_file"

if [[ ${#db_entries[@]} -eq 0 || -z "${db_entries[0]}" ]]; then
  error "No databases found"
fi

if [[ "$LIST_MODE" == "true" ]]; then
  if [[ "$namespace_explicit" == "true" ]]; then
    gum style --bold "Databases in namespace '$namespace':"
  else
    gum style --bold "Databases across all namespaces:"
  fi
  echo ""

  for entry in "${db_entries[@]}"; do
    if [[ "$entry" =~ ^([^:]+):::([^:]+):::([^:]+)$ ]]; then
      name="${BASH_REMATCH[1]}"
      ns="${BASH_REMATCH[2]}"
      type="${BASH_REMATCH[3]}"

      if [[ "$type" == "cnpg" ]]; then
        gum style --foreground 33 "  • ${ns}.${name}" --foreground 240 " [CNPG]"
      else
        gum style --foreground 33 "  • ${ns}.${name}" --foreground 240 " [Deployment]"
      fi
    fi
  done
  exit 0
fi

if [[ -z "$cluster" ]]; then
  mapfile -t sorted_entries < <(
    for entry in "${db_entries[@]}"; do
      if [[ "$entry" =~ ^([^:]+):::([^:]+):::([^:]+)$ ]]; then
        name="${BASH_REMATCH[1]}"
        ns="${BASH_REMATCH[2]}"
        type="${BASH_REMATCH[3]}"
        if [[ "$type" == "cnpg" ]]; then
          echo "${ns}.${name} [CNPG]|||${entry}"
        else
          echo "${ns}.${name} [Deployment]|||${entry}"
        fi
      fi
    done | sort | cut -d'|' -f4-
  )

  display_items=()
  for entry in "${sorted_entries[@]}"; do
    if [[ "$entry" =~ ^([^:]+):::([^:]+):::([^:]+)$ ]]; then
      name="${BASH_REMATCH[1]}"
      ns="${BASH_REMATCH[2]}"
      type="${BASH_REMATCH[3]}"

      if [[ "$type" == "cnpg" ]]; then
        display_items+=("${ns}.${name} [CNPG]")
      else
        display_items+=("${ns}.${name} [Deployment]")
      fi
    fi
  done

  if [[ ${#display_items[@]} -eq 0 ]]; then
    error "No valid databases found"
  fi

  if [[ ${#sorted_entries[@]} -eq 1 ]]; then
    selected_display="${display_items[0]}"
    selected_entry="${sorted_entries[0]}"
  else
    info "Select database:"
    selected_display=$(printf '%s\n' "${display_items[@]}" | \
      gum filter --placeholder "Type to search..." --height 20 --header "Select database to connect:")

    for i in "${!display_items[@]}"; do
      if [[ "${display_items[$i]}" == "$selected_display" ]]; then
        selected_entry="${sorted_entries[$i]}"
        break
      fi
    done
  fi

  if [[ "$selected_entry" =~ ^([^:]+):::([^:]+):::([^:]+)$ ]]; then
    cluster="${BASH_REMATCH[1]}"
    namespace="${BASH_REMATCH[2]}"
    db_type="${BASH_REMATCH[3]}"
  fi
else
  for entry in "${db_entries[@]}"; do
    if [[ "$entry" =~ ^([^:]+):::([^:]+):::([^:]+)$ ]]; then
      if [[ "${BASH_REMATCH[1]}" == "$cluster" ]]; then
        namespace="${BASH_REMATCH[2]}"
        db_type="${BASH_REMATCH[3]}"
        break
      fi
    fi
  done
fi

if [[ -z "$db_type" ]]; then
  error "Database '$cluster' not found"
fi

if [[ "$db_type" == "cnpg" ]]; then
  success "Selected: ${namespace}.${cluster} [CNPG]"
else
  success "Selected: ${namespace}.${cluster} [Deployment]"
fi

if [[ "$db_type" == "deployment" ]]; then
  warning "Connecting to non-CNPG database with read-write capability"
  gum style --foreground 240 "  (No separate read-only endpoint available)"
  echo ""
elif [[ "$READ_WRITE" == "true" ]]; then
  warning "Connecting with READ-WRITE access"
  gum style --foreground 240 "  Use caution - changes will be written to the database"
  echo ""
fi

connection_type="read-only"
if [[ "$db_type" == "deployment" ]]; then
  connection_type="read-write (deployment)"
elif [[ "$USE_POOLER" == "true" ]]; then
  connection_type="pooler"
elif [[ "$READ_WRITE" == "true" ]]; then
  connection_type="read-write"
fi

echo ""
gum style --foreground 33 "Connecting to ${namespace}.${cluster} [$connection_type]"
echo ""

get_credentials_cnpg() {
  local ns="$1"
  local clust="$2"
  local ctx_flag=""
  [[ -n "$context" ]] && ctx_flag="--context=$context"

  local secret_patterns=(
    "${clust}-app"
    "${clust}-rnchr-secret"
  )

  local app_name=$(echo "$clust" | sed -E 's/-db-.*$//' | sed -E 's/-ha$//')
  if [[ -n "$app_name" && "$app_name" != "$clust" ]]; then
    secret_patterns+=("rnchr-${app_name}-db-creds")
  fi

  for pattern in "${secret_patterns[@]}"; do
    local check_output
    check_output=$(kubectl $ctx_flag -n "$ns" get secret "$pattern"  2>&1)
    local check_exit=$?

    if [[ $check_exit -ne 0 ]]; then
      if echo "$check_output" | grep -qiE "(timed out|i/o timeout|unable to connect|connection refused|token.*expired|not logged in|unauthorized)"; then
        echo "KUBECTL_ERROR: $check_output" >&2
        return 1
      fi
      continue
    fi

    local pg_user=$(kubectl $ctx_flag -n "$ns" get secret "$pattern" -o go-template='{{index .data "username"}}'  2>&1 | base64 -d 2>/dev/null || echo "")
    local pg_pass=$(kubectl $ctx_flag -n "$ns" get secret "$pattern" -o go-template='{{index .data "password"}}'  2>&1 | base64 -d 2>/dev/null || echo "")
    local pg_db=$(kubectl $ctx_flag -n "$ns" get secret "$pattern" -o go-template='{{index .data "dbname"}}'  2>&1 | base64 -d 2>/dev/null || echo "")

    [[ -z "$pg_db" ]] && pg_db="__AUTO_DISCOVER__"

    echo "USERNAME=$pg_user"
    echo "PASSWORD=$pg_pass"
    echo "DATABASE=$pg_db"
    return 0
  done

  return 1
}

get_credentials_deployment() {
  local ns="$1"
  local svc_name="$2"
  local ctx_flag=""
  [[ -n "$context" ]] && ctx_flag="--context=$context"

  local pods_output
  pods_output=$(kubectl $ctx_flag -n "$ns" get pods -o json  2>&1)
  local pods_exit=$?

  if [[ $pods_exit -ne 0 ]]; then
    if echo "$pods_output" | grep -qiE "(timed out|i/o timeout|unable to connect|connection refused|token.*expired|not logged in|unauthorized)"; then
      echo "KUBECTL_ERROR: $pods_output" >&2
      return 1
    fi
    return 1
  fi

  local pod_name=$(echo "$pods_output" | jq -r --arg svc "$svc_name" '.items[] | select(.metadata.name | startswith($svc)) | .metadata.name' | head -1)

  [[ -z "$pod_name" ]] && return 1

  local pod_output
  pod_output=$(kubectl $ctx_flag -n "$ns" get pod "$pod_name" -o json  2>&1)
  local pod_exit=$?

  if [[ $pod_exit -ne 0 ]]; then
    if echo "$pod_output" | grep -qiE "(timed out|i/o timeout|unable to connect|connection refused|token.*expired|not logged in|unauthorized)"; then
      echo "KUBECTL_ERROR: $pod_output" >&2
      return 1
    fi
    return 1
  fi

  local env_json=$(echo "$pod_output" | jq '.spec.containers[0].env')

  local pg_user=$(echo "$env_json" | jq -r '.[] | select(.name == "POSTGRES_USER") | .value' 2>/dev/null || echo "")
  local pg_pass=$(echo "$env_json" | jq -r '.[] | select(.name == "POSTGRES_PASSWORD") | .value' 2>/dev/null || echo "")
  local pg_db=$(echo "$env_json" | jq -r '.[] | select(.name == "POSTGRES_DB") | .value' 2>/dev/null || echo "")

  if [[ -z "$pg_pass" ]]; then
    local secret_name=$(echo "$env_json" | jq -r '.[] | select(.name == "POSTGRES_PASSWORD") | .valueFrom.secretKeyRef.name' 2>/dev/null || echo "")
    local secret_key=$(echo "$env_json" | jq -r '.[] | select(.name == "POSTGRES_PASSWORD") | .valueFrom.secretKeyRef.key' 2>/dev/null || echo "")
    if [[ -n "$secret_name" && -n "$secret_key" ]]; then
      local secret_output
      secret_output=$(kubectl $ctx_flag -n "$ns" get secret "$secret_name" -o jsonpath="{.data.${secret_key}}"  2>&1)
      local secret_exit=$?

      if [[ $secret_exit -ne 0 ]]; then
        if echo "$secret_output" | grep -qiE "(timed out|i/o timeout|unable to connect|connection refused|token.*expired|not logged in|unauthorized)"; then
          echo "KUBECTL_ERROR: $secret_output" >&2
          return 1
        fi
      else
        pg_pass=$(echo "$secret_output" | base64 -d 2>/dev/null)
      fi
    fi
  fi

  [[ -z "$pg_db" ]] && pg_db="__AUTO_DISCOVER__"

  echo "USERNAME=$pg_user"
  echo "PASSWORD=$pg_pass"
  echo "DATABASE=$pg_db"
  return 0
}

if [[ "$db_type" == "deployment" ]]; then
  creds_output=$(gum spin --spinner dot --title "Retrieving credentials..." -- bash -c "
    context='$context'
    $(declare -f get_credentials_deployment)
    get_credentials_deployment '$namespace' '$cluster' 2>&1
    exit \$?
  ")
  creds_exit=$?
else
  creds_output=$(gum spin --spinner dot --title "Retrieving credentials..." -- bash -c "
    context='$context'
    $(declare -f get_credentials_cnpg)
    get_credentials_cnpg '$namespace' '$cluster' 2>&1
    exit \$?
  ")
  creds_exit=$?
fi

if [[ $creds_exit -ne 0 ]]; then
  if echo "$creds_output" | grep -q "KUBECTL_ERROR:"; then
    error_msg=$(echo "$creds_output" | grep "KUBECTL_ERROR:" | sed 's/KUBECTL_ERROR: //')
    handle_kubectl_error "$error_msg"
  else
    error "Failed to retrieve credentials"
  fi
elif [[ -z "$creds_output" ]]; then
  error "Failed to retrieve credentials"
fi

while IFS='=' read -r key value; do
  case "$key" in
    USERNAME) USERNAME="$value" ;;
    PASSWORD) PASSWORD="$value" ;;
    DATABASE) DATABASE="$value" ;;
  esac
done <<< "$creds_output"

if [[ -z "$USERNAME" || -z "$PASSWORD" ]]; then
  error "Invalid credentials"
fi

if [[ "$db_type" == "deployment" ]]; then
  service="$cluster"
elif [[ "$USE_POOLER" == "true" ]]; then
  service="${cluster}-pooler"
elif [[ "$READ_WRITE" == "true" ]]; then
  service="${cluster}-rw"
else
  service="${cluster}-ro"
fi

find_available_port() {
  local port
  for ((i=1; i<=PORT_FIND_ATTEMPTS; i++)); do
    port=$((PORT_RANGE_START + RANDOM % (PORT_RANGE_END - PORT_RANGE_START)))
    if ! nc -z localhost "$port" 2>/dev/null; then
      echo "$port"
      return 0
    fi
  done
  echo "15432"
}

if [[ -z "$port" ]]; then
  port=$(find_available_port)
fi

pgpass_file=$(mktemp)
chmod "$PGPASS_FILE_MODE" "$pgpass_file"
echo "localhost:$port:*:$USERNAME:$PASSWORD" > "$pgpass_file"

cleanup() {
  if [[ -n "$pf_monitor_pid" && -e /proc/$pf_monitor_pid ]]; then
    kill "$pf_monitor_pid" 2>/dev/null || true
    wait "$pf_monitor_pid" 2>/dev/null || true
  fi
  if [[ -n "$pf_pid" && -e /proc/$pf_pid ]]; then
    kill "$pf_pid" 2>/dev/null || true
    wait "$pf_pid" 2>/dev/null || true
  fi
  if [[ -n "$pgpass_file" && -f "$pgpass_file" ]]; then
    rm -f "$pgpass_file"
  fi
}
trap cleanup EXIT INT TERM

start_port_forward() {
  local timeout="${1:-$PORT_FORWARD_TIMEOUT}"
  local attempt=0
  local ctx_flag=""

  [[ -n "$context" ]] && ctx_flag="--context=$context"

  while [[ $attempt -lt $timeout ]]; do
    if [[ -n "$pf_pid" && -e /proc/$pf_pid ]]; then
      kill "$pf_pid" 2>/dev/null || true
      wait "$pf_pid" 2>/dev/null || true
    fi

    kubectl $ctx_flag -n "$namespace" port-forward service/"$service" "$port":5432 >/dev/null 2>&1 &
    pf_pid=$!

    local ready_check=0
    while [[ $ready_check -lt 10 ]]; do
      if nc -z localhost "$port" 2>/dev/null; then
        sleep 1
        return 0
      fi
      sleep 1
      ready_check=$((ready_check + 1))
      attempt=$((attempt + 1))

      if [[ $attempt -ge $timeout ]]; then
        return 1
      fi
    done
  done

  return 1
}

monitor_port_forward() {
  while true; do
    if [[ ! -e /proc/$pf_pid ]]; then
      pf_retry_count=$((pf_retry_count + 1))

      if [[ "$QUIET" == "false" ]]; then
        printf '\n\033[1;33m⚠ Port-forward disconnected (attempt %d)\033[0m\n' "$pf_retry_count" >&2
        printf '\033[38;5;240m  Reconnecting...\033[0m\n' >&2
      fi

      if start_port_forward "$PORT_FORWARD_RECONNECT_TIMEOUT"; then
        if [[ "$QUIET" == "false" ]]; then
          printf '\033[1;32m✓ Reconnected successfully\033[0m\n\n' >&2
        fi
      else
        if [[ "$QUIET" == "false" ]]; then
          printf '\033[1;31m✗ Failed to reconnect\033[0m\n' >&2
        fi

        if [[ $pf_retry_count -ge $PORT_FORWARD_MAX_RETRIES ]]; then
          printf '\033[1;31m✗ Max retries reached\033[0m\n' >&2
          kill -TERM $$ 2>/dev/null
          exit 1
        fi
      fi
    fi

    sleep 2
  done
}

ctx_flag=""
[[ -n "$context" ]] && ctx_flag="--context=$context"

gum spin --spinner dot --title "Establishing connection..." -- bash -c "
  $(declare -f start_port_forward)
  context='$context'
  namespace='$namespace'
  service='$service'
  port='$port'
  ctx_flag='$ctx_flag'
  PORT_FORWARD_TIMEOUT='$PORT_FORWARD_TIMEOUT'
  start_port_forward
  echo \$! > /tmp/pgc-pf-pid.$$
"

if [[ $? -ne 0 ]]; then
  error "Port-forward failed to start"
fi

pf_pid=$(cat /tmp/pgc-pf-pid.$$ 2>/dev/null)
rm -f /tmp/pgc-pf-pid.$$

monitor_port_forward &
pf_monitor_pid=$!

if [[ "$DATABASE" == "__AUTO_DISCOVER__" ]]; then
  DATABASE="$USERNAME"
fi

[[ -n "$database" ]] && DATABASE="$database"

custom_prompt="${context}.${cluster}.%/%R%# "

if [[ -n "$sql_execute" ]]; then
  PGCONNECT_TIMEOUT="$PG_CONNECT_TIMEOUT" PGPASSFILE="$pgpass_file" \
    psql -h localhost -p "$port" -U "$USERNAME" -d "$DATABASE" -c "$sql_execute"
elif [[ -n "$sql_file" ]]; then
  if [[ ! -f "$sql_file" ]]; then
    error "SQL file not found: $sql_file"
  fi
  PGCONNECT_TIMEOUT="$PG_CONNECT_TIMEOUT" PGPASSFILE="$pgpass_file" \
    psql -h localhost -p "$port" -U "$USERNAME" -d "$DATABASE" -f "$sql_file"
else
  gum style --border rounded --padding "1" --border-foreground 33 \
    "Connected to: ${namespace}.${cluster}" \
    "Database: $DATABASE" \
    "Type 'exit' or press Ctrl+D to disconnect"
  echo ""

  PGCONNECT_TIMEOUT="$PG_CONNECT_TIMEOUT" PGPASSFILE="$pgpass_file" PAGER=off \
    psql -h localhost -p "$port" -U "$USERNAME" -d "$DATABASE" \
    -v PROMPT1="$custom_prompt" -v PROMPT2="$custom_prompt"
fi

echo ""
gum style --foreground 2 "✓ Disconnected. Goodbye!"
