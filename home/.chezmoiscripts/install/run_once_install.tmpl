#!/bin/bash
set -e  # Exit on error

echo "=========================================="
echo "Setting up dotfiles for: {{ .chezmoi.osRelease.prettyName }}"
echo "Hostname: {{ .chezmoi.hostname }}"
echo "=========================================="

# Common setup for all distros
echo ""
echo "==> Setting up common directories and files..."
mkdir -p ~/Pictures/wallpapers
mkdir -p ~/.local/bin

# Clone wallpapers if not present (shallow clone to save space)
if [ ! -d ~/Pictures/wallpapers/catppuccin-wallpapers ]; then
    echo "==> Cloning catppuccin wallpapers..."
    git clone --depth 1 https://github.com/zhichaoh/catppuccin-wallpapers ~/Pictures/wallpapers/catppuccin-wallpapers
else
    echo "==> Wallpapers already exist, skipping..."
fi

echo "Detected system: {{ .chezmoi.osRelease.prettyName }}"

{{ if eq .chezmoi.osRelease.id "arch" -}}
echo ""
echo "==> Arch Linux Setup"

# Ensure yay is installed
{{ if not (findExecutable "yay" (list "/sbin/" "/bin/" "/usr/sbin/" "/usr/bin/" )) }}
echo "==> Installing yay AUR helper..."
sudo pacman -S --needed --noconfirm git base-devel
git clone https://aur.archlinux.org/yay.git /tmp/yay
(cd /tmp/yay && makepkg -si --noconfirm)
rm -rf /tmp/yay
{{end}}

echo "==> Enabling NTP..."
sudo timedatectl set-ntp true

echo "==> Installing packages..."
yay -S --needed --noconfirm {{ .install.arch.yay | join " " }}

echo "==> Installing kubectl plugins..."
if command -v kubectl &> /dev/null && command -v kubectl-krew &> /dev/null; then
    kubectl krew install {{ .install.arch.krew | join " " }} || echo "Warning: Some kubectl plugins failed to install"
else
    echo "Warning: kubectl or krew not found, skipping kubectl plugins"
fi
{{ else if eq .chezmoi.osRelease.id "fedora" -}}
    echo "Updating packages..."
    sudo dnf -y -q update

    echo "Enabling RPM Fusion..."
    sudo dnf install https://mirrors.rpmfusion.org/free/fedora/rpmfusion-free-release-$(rpm -E %fedora).noarch.rpm https://mirrors.rpmfusion.org/nonfree/fedora/rpmfusion-nonfree-release-$(rpm -E %fedora).noarch.rpm
    sudo dnf config-manager setopt fedora-cisco-openh264.enabled=1


    echo "Installing DNF packages..."
    echo "{{ .install.fedora.dnf | join " "}}"
    sudo dnf install -y {{ .install.fedora.dnf | join " "}}

    echo "Setting up custom repos..."
    {{ range $v := .install.fedora.repos }}
        sudo dnf config-manager addrepo --from-repofile={{ $v.repoFile }}
        sudo dnf install -y {{ $v.packages | join " "}}
    {{ end }}
    {{ range $v := .install.fedora.copr }}
        sudo dnf copr enable -y {{ $v.repo }}
        sudo dnf install -y {{ $v.package }}
    {{ end }}

    echo "Installing packages from language repos"
    {{ range $v := .install.fedora.golang }}
        go install $v
    {{ end }}
    {{ range $v := .install.fedora.cargo }}
        cargo install $v
    {{ end }}

    echo "Installing Flathub packages..."
    flatpak install flathub {{ .install.fedora.flathub | join " "}}

    echo "Packages that need to be installed manually:"
    echo "{{ .install.fedora.manual | join ", "}}"

{{ else -}}
echo ""
echo "Warning: Automatic package installation is not supported for this OS."
{{ end -}}

# Post-install steps (common for all distros)
echo ""
echo "==> Post-install configuration..."

# Enable services if they exist
if systemctl list-unit-files | grep -q gdm.service; then
    sudo systemctl enable gdm
fi

if systemctl list-unit-files | grep -q docker.service; then
    sudo systemctl enable docker
    # Add user to docker group
    if ! groups $USER | grep -q docker; then
        sudo usermod -aG docker $USER
        echo "Added $USER to docker group (logout required)"
    fi
fi

# Set zsh as default shell if installed
if command -v zsh &> /dev/null; then
    if [ "$SHELL" != "$(which zsh)" ]; then
        echo "==> Setting zsh as default shell..."
        chsh -s $(which zsh)
    fi
fi

echo ""
echo "=========================================="
echo "Setup complete!"
echo "=========================================="
echo "Please logout and login again for all changes to take effect."