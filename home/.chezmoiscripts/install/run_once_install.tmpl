#!/bin/bash
set -e  # Exit on error

echo "=========================================="
echo "Setting up dotfiles for: {{ .chezmoi.osRelease.prettyName }}"
echo "Hostname: {{ .chezmoi.hostname }}"
echo "=========================================="

# Prerequisites check
echo ""
echo "==> Checking prerequisites..."

# Check if bitwarden-cli is installed
if ! command -v bw &> /dev/null; then
    echo "ERROR: Bitwarden CLI (bw) is not installed!"
    echo "Please install it first:"
    echo "  Arch: yay -S bitwarden-cli"
    echo "  Fedora: sudo dnf install bitwarden-cli"
    echo "Then login: bw login"
    exit 1
fi

# Check Bitwarden status and unlock if needed
BW_STATUS=$(bw status | jq -r .status)

if [ "$BW_STATUS" == "unauthenticated" ]; then
    echo "ERROR: Not logged in to Bitwarden!"
    echo "Please run: bw login"
    exit 1
elif [ "$BW_STATUS" == "locked" ]; then
    echo "==> Unlocking Bitwarden vault..."
    export BW_SESSION=$(bw unlock --raw)
    if [ -z "$BW_SESSION" ]; then
        echo "ERROR: Failed to unlock Bitwarden"
        exit 1
    fi
    echo "✓ Bitwarden unlocked"
elif [ "$BW_STATUS" == "unlocked" ]; then
    echo "✓ Bitwarden already unlocked"
    # Session might be in environment already
    if [ -z "$BW_SESSION" ]; then
        echo "Warning: BW_SESSION not set, attempting to get session..."
        export BW_SESSION=$(bw unlock --raw)
    fi
fi

# Setup age encryption key from Bitwarden
echo ""
echo "==> Setting up age encryption..."
mkdir -p ~/.config/age

if [ ! -f ~/.config/age/key.txt ]; then
    echo "==> Retrieving age key from Bitwarden..."

    # Get the age key from Bitwarden secure note
    AGE_KEY=$(bw get notes "chezmoi-age-key" 2>/dev/null || echo "")

    if [ -z "$AGE_KEY" ]; then
        echo "ERROR: Could not find 'chezmoi-age-key' in Bitwarden!"
        echo ""
        echo "Please create a Secure Note in Bitwarden:"
        echo "  1. Open Bitwarden"
        echo "  2. Create new Secure Note"
        echo "  3. Name: chezmoi-age-key"
        echo "  4. Note content: Paste your age key from ~/.config/age/key.txt"
        echo ""
        echo "Your current age key:"
        cat ~/.config/age/key.txt 2>/dev/null || echo "(age key not found on this machine)"
        exit 1
    fi

    echo "$AGE_KEY" > ~/.config/age/key.txt
    chmod 600 ~/.config/age/key.txt
    echo "✓ Age key retrieved and saved"
else
    echo "✓ Age key already exists"
fi

# Setup machine-specific data from Bitwarden
echo ""
echo "==> Setting up machine data from Bitwarden..."
CHEZMOI_DATA_DIR="{{ .chezmoi.sourceDir }}/home/.chezmoidata"
mkdir -p "$CHEZMOI_DATA_DIR"

if [ ! -f "$CHEZMOI_DATA_DIR/machine.yaml" ]; then
    echo "==> Retrieving machine identity from Bitwarden..."

    # Get the identity data from Bitwarden
    BW_IDENTITY=$(bw get item chezmoi-identity 2>/dev/null)

    if [ -z "$BW_IDENTITY" ]; then
        echo "ERROR: Could not find 'chezmoi-identity' in Bitwarden!"
        echo ""
        echo "Please create an Identity item in Bitwarden:"
        echo "  Name: chezmoi-identity"
        echo "  First Name: Your first name"
        echo "  Last Name: Your last name"
        echo "  Username: Your system username"
        echo "  Email: Your email for this machine"
        echo "  Company: Machine type (e.g., 'work', 'personal', or company name)"
        echo "  Custom field 'git-user': Your git username"
        exit 1
    fi

    # Parse the identity data and create machine.yaml
    cat > "$CHEZMOI_DATA_DIR/machine.yaml" <<EOF
machine:
  type: "$(echo "$BW_IDENTITY" | jq -r '.identity.company')"
  hostname: "{{ .chezmoi.hostname }}"

user:
  name: "$(echo "$BW_IDENTITY" | jq -r '.identity.firstName + " " + .identity.lastName')"
  username: "$(echo "$BW_IDENTITY" | jq -r '.identity.username')"
  email: "$(echo "$BW_IDENTITY" | jq -r '.identity.email')"
  git_user: "$(echo "$BW_IDENTITY" | jq -r '.fields[] | select(.name=="git-user") | .value')"
EOF

    echo "✓ Machine data retrieved and saved"
else
    echo "✓ Machine data already exists"
fi

# Common setup for all distros
echo ""
echo "==> Setting up common directories and files..."
mkdir -p ~/Pictures/wallpapers
mkdir -p ~/.local/bin

# Clone wallpapers if not present (shallow clone to save space)
if [ ! -d ~/Pictures/wallpapers/catppuccin-wallpapers ]; then
    echo "==> Cloning catppuccin wallpapers..."
    git clone --depth 1 https://github.com/zhichaoh/catppuccin-wallpapers ~/Pictures/wallpapers/catppuccin-wallpapers
else
    echo "==> Wallpapers already exist, skipping..."
fi

echo "Detected system: {{ .chezmoi.osRelease.prettyName }}"

{{ if eq .chezmoi.osRelease.id "arch" -}}
echo ""
echo "==> Arch Linux Setup"

# Ensure yay is installed
{{ if not (findExecutable "yay" (list "/sbin/" "/bin/" "/usr/sbin/" "/usr/bin/" )) }}
echo "==> Installing yay AUR helper..."
sudo pacman -S --needed --noconfirm git base-devel
git clone https://aur.archlinux.org/yay.git /tmp/yay
(cd /tmp/yay && makepkg -si --noconfirm)
rm -rf /tmp/yay
{{end}}

echo "==> Enabling NTP..."
sudo timedatectl set-ntp true

echo "==> Installing packages..."
yay -S --needed --noconfirm {{ .install.arch.yay | join " " }}

echo "==> Installing kubectl plugins..."
if command -v kubectl &> /dev/null && command -v kubectl-krew &> /dev/null; then
    kubectl krew install {{ .install.arch.krew | join " " }} || echo "Warning: Some kubectl plugins failed to install"
else
    echo "Warning: kubectl or krew not found, skipping kubectl plugins"
fi
{{ else if eq .chezmoi.osRelease.id "fedora" -}}
    echo "Updating packages..."
    sudo dnf -y -q update

    echo "Enabling RPM Fusion..."
    sudo dnf install https://mirrors.rpmfusion.org/free/fedora/rpmfusion-free-release-$(rpm -E %fedora).noarch.rpm https://mirrors.rpmfusion.org/nonfree/fedora/rpmfusion-nonfree-release-$(rpm -E %fedora).noarch.rpm
    sudo dnf config-manager setopt fedora-cisco-openh264.enabled=1


    echo "Installing DNF packages..."
    echo "{{ .install.fedora.dnf | join " "}}"
    sudo dnf install -y {{ .install.fedora.dnf | join " "}}

    echo "Setting up custom repos..."
    {{ range $v := .install.fedora.repos }}
        sudo dnf config-manager addrepo --from-repofile={{ $v.repoFile }}
        sudo dnf install -y {{ $v.packages | join " "}}
    {{ end }}
    {{ range $v := .install.fedora.copr }}
        sudo dnf copr enable -y {{ $v.repo }}
        sudo dnf install -y {{ $v.package }}
    {{ end }}

    echo "Installing packages from language repos"
    {{ range $v := .install.fedora.golang }}
        go install $v
    {{ end }}
    {{ range $v := .install.fedora.cargo }}
        cargo install $v
    {{ end }}

    echo "Installing Flathub packages..."
    flatpak install flathub {{ .install.fedora.flathub | join " "}}

    echo "Packages that need to be installed manually:"
    echo "{{ .install.fedora.manual | join ", "}}"

{{ else -}}
echo ""
echo "Warning: Automatic package installation is not supported for this OS."
{{ end -}}

# Post-install steps (common for all distros)
echo ""
echo "==> Post-install configuration..."

# Enable services if they exist
if systemctl list-unit-files | grep -q gdm.service; then
    sudo systemctl enable gdm
fi

if systemctl list-unit-files | grep -q docker.service; then
    sudo systemctl enable docker
    # Add user to docker group
    if ! groups $USER | grep -q docker; then
        sudo usermod -aG docker $USER
        echo "Added $USER to docker group (logout required)"
    fi
fi

# Set zsh as default shell if installed
if command -v zsh &> /dev/null; then
    if [ "$SHELL" != "$(which zsh)" ]; then
        echo "==> Setting zsh as default shell..."
        chsh -s $(which zsh)
    fi
fi

# Enable chezmoi status check timer
echo "==> Setting up chezmoi status check timer..."
systemctl --user daemon-reload
systemctl --user enable --now chezmoi-check.timer
echo "✓ Chezmoi status check will run daily at 11:00 AM"

echo ""
echo "=========================================="
echo "Setup complete!"
echo "=========================================="
echo "Please logout and login again for all changes to take effect."